{% extends 'base.html.twig' %}

{% block title %}Reviews · Review Aggregator{% endblock %}

{% set platformColor = {'google': '#ea4335', 'facebook': '#1877f2', 'trustpilot': '#00b67a', 'yelp': '#ff1a1a'} %}

{% block body %}
    <div class="page-head">
        <div>
            <h2>Reviews</h2>
            <p>Aggregated customer reviews across every connected platform.</p>
        </div>
    </div>

    <div class="card card-pad">
        <div class="hero">
            <div class="hero-score">
                <div class="num">{{ stats.average }}</div>
                <div class="stars">{% for i in 1..5 %}<span class="{{ i <= stats.average|round(0, 'floor') ? '' : 'empty' }}">★</span>{% endfor %}</div>
                <div class="count">{{ stats.total }} review{{ stats.total == 1 ? '' : 's' }}</div>
            </div>
            <div>
                {% for score in 5..1 %}
                    {% set count = stats.distribution[score] %}
                    {% set pct = stats.total > 0 ? (count / stats.total * 100)|round : 0 %}
                    <div class="dist-row">
                        <span class="lbl">{{ score }} <span class="s">★</span></span>
                        <span class="bar"><span style="width: {{ pct }}%"></span></span>
                        <span class="val">{{ count }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card card-pad">
        <form class="filters" method="get">
            <div class="field">
                <label>Platform</label>
                <select name="platform" onchange="this.form.submit()">
                    <option value="">All platforms</option>
                    {% for p in platforms %}
                        <option value="{{ p.value }}" {{ filter.platform == p ? 'selected' : '' }}>{{ p.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="field">
                <label>Minimum rating</label>
                <select name="minRating" onchange="this.form.submit()">
                    <option value="">Any rating</option>
                    {% for score in 1..5 %}
                        <option value="{{ score }}" {{ filter.minRating == score ? 'selected' : '' }}>{{ score }}★ &amp; up</option>
                    {% endfor %}
                </select>
            </div>
            {% if filter.platform or filter.minRating %}
                <a class="btn-ghost btn" href="{{ path('admin_reviews_index') }}">Reset</a>
            {% endif %}
        </form>
    </div>

    <div class="card">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Platform</th>
                        <th>Author</th>
                        <th>Rating</th>
                        <th>Review</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    {% for review in reviews %}
                        {% set initials = review.authorName|split(' ')|slice(0, 2)|map(p => p|first)|join|upper %}
                        <tr>
                            <td>
                                <span class="badge badge--{{ review.platform.value }}"><span class="dot"></span>{{ review.platform.label }}</span>
                            </td>
                            <td>
                                <div class="author">
                                    <span class="avatar" style="background: {{ platformColor[review.platform.value] ?? '#64748b' }}">{{ initials }}</span>
                                    <span class="name">{{ review.authorName }}</span>
                                </div>
                            </td>
                            <td class="stars" title="{{ review.rating }}/5">{% for i in 1..5 %}<span class="{{ i <= review.rating ? '' : 'empty' }}">★</span>{% endfor %}</td>
                            <td class="review-text">{{ review.content }}</td>
                            <td class="date">{{ review.reviewedAt|date('Y-m-d') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="empty-state">No reviews yet. Run <code>app:import-reviews</code> or add one.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
